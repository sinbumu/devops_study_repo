# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # 10주차 PDF 흐름에 맞춘 CentOS 7 기반 Docker 실습 VM
  config.vm.box = "centos/7"
  config.vm.hostname = "container"
  config.vm.boot_timeout = 1200

  config.vm.network "private_network", ip: "192.168.33.20"

  # 강의 PDF 예시는 synced_folder를 disabled 처리하지만,
  # 실습 스크립트와 README를 VM 안에서 바로 볼 수 있도록 /vagrant 공유를 유지한다.
  config.vm.synced_folder ".", "/vagrant"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "week10-container.local"
    vb.memory = 2048
    vb.cpus = 2
  end

  # Docker 설치는 강의 흐름을 따라 VM 접속 후 직접 실행하도록 스크립트만 제공한다.
  # 자동 설치를 원하면 아래 주석을 해제한다.
  # config.vm.provision "shell", path: "scripts/install_docker_centos7.sh"
end
